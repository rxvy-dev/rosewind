<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">
        <HorizontalScrollView android:id="@+id/photos" android:layout_width="match_parent" android:layout_height="196dp" android:scrollbars="none" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:clipToPadding="false">
            <LinearLayout android:id="@+id/photoRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:id="@+id/noPhotos" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:text="No photos found for this place" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingTop="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/directions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Directions" />
            <com.google.android.material.button.MaterialButton android:id="@+id/share" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Share" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
